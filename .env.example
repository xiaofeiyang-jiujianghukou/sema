# 复制为 .env 并按需修改；全部缺省时使用 mock 供应商（零成本开发/测试）

# LLM 供应商：mock（默认）| openai-compat（方舟 Ark / 百炼 compatible-mode / OpenAI）
SEMA_LLM_PROVIDER=openai-compat
# 火山方舟 Ark:    https://ark.cn-beijing.volces.com/api/v3
# 阿里百炼:        https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:          https://api.openai.com/v1
SEMA_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEMA_LLM_API_KEY=
SEMA_LLM_MODEL=doubao-seed-flash

# API 服务
PORT=8787

# 数据库（M2 接入 Postgres 仓储时使用）
# DATABASE_URL=postgres://localhost:5432/sema
