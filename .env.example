# 复制为 .env 并按需修改；全部缺省时使用 mock 供应商（零成本开发/测试）

# LLM 供应商：mock（默认）| openai-compat（方舟 Ark / 百炼 compatible-mode / OpenAI）
SEMA_LLM_PROVIDER=openai-compat
# 火山方舟平台通道:  https://ark.cn-beijing.volces.com/api/v3        （控制台 Key，token 后付费）
# 火山方舟套餐通道:  https://ark.cn-beijing.volces.com/api/plan/v3   （Agent Plan 专属 Key，AFP 抵扣）
# 阿里百炼:          https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:           https://api.openai.com/v1
SEMA_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
SEMA_LLM_API_KEY=
SEMA_LLM_MODEL=doubao-seed-2-0-mini-260428

# 语音（M1.5 实时语音：同一把 Key，走 openspeech plan 通道；不配则用默认音色）
# 音色需兼容 seed-tts-2.0，默认 zh_female_gaolengyujie_uranus_bigtts
SEMA_TTS_SPEAKER=zh_female_gaolengyujie_uranus_bigtts

# API 服务
PORT=8787

# 数据库（M2 接入 Postgres 仓储时使用）
# DATABASE_URL=postgres://localhost:5432/sema
