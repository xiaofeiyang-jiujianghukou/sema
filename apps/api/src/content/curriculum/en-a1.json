        {"term": "meet", "meaning": "v. 认识；见面", "example": "Nice to meet you.", "exampleZh": "很高兴认识你。"},
        {"term": "morning", "meaning": "n. 早晨；上午", "example": "Good morning, Miss Li.", "exampleZh": "早上好，李老师。"},
        {"term": "afternoon", "meaning": "n. 下午", "example": "Good afternoon, Mr. Wang.", "exampleZh": "下午好，王先生。"},
        {"term": "evening", "meaning": "n. 晚上；傍晚", "example": "Good evening, Dad.", "exampleZh": "晚上好，爸爸。"},
